# Git boundary: Dynamic_ExpA/ only, not the parent workspace.
# Version runtime source, experiments, docs, tooling and shared configuration:
# agent_system/, verl_extensions/, verl/, experiments/, ops/,
# scripts/, docker/, docs/, examples/, root project files.
# Exclude local resources below; new source directories are included by default.

# Python and packaging
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
*.egg
.eggs/
eggs/
develop-eggs/
build/
dist/
downloads/
lib/
lib64/
parts/
sdist/
var/
tmp/
.installed.cfg
*.manifest
*.spec
pip-log.txt
pip-delete-this-directory.txt

# Local environments
.venvs/
.venv/
.venv.*/
venv/
ENV/
!**/workers/env/

# Developer tests, smoke runs and their resources live only in dyad_test/.
/dyad_test/
**/test/
**/tests/
**/unittest/
test_*.py
*_test.py
*smoke*.py
*smoke*.sh
*somk*.py
# SWE-bench's test specification is a production grading component.
!agent_system/environments/env_package/swebench/source/swebench/harness/test_spec/test_spec.py

# Local agent instructions are maintained by the workspace.
[Aa][Gg][Ee][Nn][Tt][Ss].[Mm][Dd]
[Cc][Ll][Aa][Uu][Dd][Ee].[Mm][Dd]
[Cc][Ll][Uu][Aa][Dd][Ee].[Mm][Dd]

